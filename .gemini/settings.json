{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node PONYTAIL_DIR/hooks/ponytail-mode-tracker.js"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "task|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node PONYTAIL_DIR/hooks/ponytail-subagent.js"
          }
        ]
      }
    ]
  }
}
