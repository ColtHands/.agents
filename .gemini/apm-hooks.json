{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node PONYTAIL_DIR/hooks/ponytail-mode-tracker.js"
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ],
  "BeforeTool": [
    {
      "matcher": "task|Task",
      "hooks": [
        {
          "type": "command",
          "command": "node PONYTAIL_DIR/hooks/ponytail-subagent.js"
        }
      ],
      "_apm_source": "dietrichgebert/ponytail"
    }
  ]
}
